{
  "name": "Isaac Sim Dev (4.2.0)",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "overrideCommand": true,
  "workspaceFolder": "/isaac-sim",
  "shutdownAction": "stopCompose",
  "remoteUser": "root",
  "remoteEnv": {
    "PATH": "/isaac-sim/kit/python/bin:${containerEnv:PATH}",
    "ISAAC_SIM_PATH": "/isaac-sim",
    "PYTHONPATH": "/isaac-sim/kit/python/bin/python3"
  },
  "postCreateCommand": "ln -sf /isaac-sim/kit/python/bin/python3 /isaac-sim/kit/python/bin/python",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.black-formatter",
        "charliermarsh.ruff"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/isaac-sim/kit/python/bin/python3",
        "python.formatting.provider": "black",
        "editor.formatOnSave": true,
        "python.analysis.diagnosticSeverityOverrides": {
          "reportMissingImports": "warning"
        }
      }
    }
  },
  "service": "isaac-sim-4.2.0",
  "runServices": [
    "isaac-sim-4.2.0"
  ]
}
