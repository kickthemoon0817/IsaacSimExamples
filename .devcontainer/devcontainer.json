{
  "name": "Isaac Sim Dev (5.0.0)",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "overrideCommand": true,
  "workspaceFolder": "/isaac-sim",
  "shutdownAction": "stopCompose",
  "remoteUser": "root",
  "remoteEnv": {
    "PATH": "/isaac-sim/kit/python/bin:${containerEnv:PATH}",
    "ISAAC_PATH": "/isaac-sim",
    "CARB_APP_PATH": "/isaac-sim/kit",
    "EXP_PATH": "/isaac-sim/apps",
    "PYTHONPATH": "/isaac-sim/kit/python/bin/python3"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "args": ["-l"]
          }
        },
        "python.defaultInterpreterPath": "/isaac-sim/kit/python/bin/python3"
      }
    }
  },
  "service": "isaac-sim-5.0.0",
  "runServices": [
    "isaac-sim-5.0.0"
  ]
}
